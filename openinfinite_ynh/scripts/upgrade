#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Settings introduced after the first release get a value on older installs.
if [ -z "${default_paper:-}" ]; then
    default_paper="letter"
    ynh_app_setting_set --key=default_paper --value="$default_paper"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Replace the old build entirely: bundle file names are content-hashed, so
# stale files would otherwise pile up.
ynh_setup_source --dest_dir="$install_dir" --full_replace

_write_site_config
_set_permissions

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
