#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# With packaging v2, YunoHost saves the install answers (domain, path,
# init_main_permission, default_paper) as app settings itself and loads every
# setting as a bash variable here, so no ynh_app_setting_set call is needed.
# The resources from manifest.toml ($install_dir, the $app system user, the
# permissions) are provisioned before this script runs.

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Pre-built static release from manifest.toml (checksum verified). Nothing is
# compiled here, so installing costs no CPU or RAM beyond unpacking ~4 MB.
ynh_setup_source --dest_dir="$install_dir"

_write_site_config
_set_permissions

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
